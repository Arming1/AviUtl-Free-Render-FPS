# Canonical small evidence is intentionally reviewable. The exceptions must
# appear after the generated-artifact rules above. Large media/binaries remain
# ignored even when stored below an evidence directory.
!experiments/
!experiments/**/evidence/
!experiments/**/evidence/**
experiments/**/evidence/**/*.exe
experiments/**/evidence/**/*.dll
experiments/**/evidence/**/*.obj
experiments/**/evidence/**/*.o
experiments/**/evidence/**/*.a
experiments/**/evidence/**/*.lib
experiments/**/evidence/**/*.exp
experiments/**/evidence/**/*.ilk
experiments/**/evidence/**/*.idb
experiments/**/evidence/**/*.pdb
experiments/**/evidence/**/*.pch
experiments/**/evidence/**/*.ipch
experiments/**/evidence/**/*.metagen
experiments/**/evidence/**/*.recipe
experiments/**/evidence/**/*.auo*
experiments/**/evidence/**/*.auf*
experiments/**/evidence/**/*.mp4
experiments/**/evidence/**/*.mkv
experiments/**/evidence/**/*.avi
experiments/**/evidence/**/*.mov
experiments/**/evidence/**/*.webm
experiments/**/evidence/**/*.wav
experiments/**/evidence/**/*.aac

